<?xml version="1.0" encoding="UTF-8"?>
<!--
    Couriva - IIS 10 Configuration for Windows Server 2019
    Supports PHP 8.x via FastCGI, URL Rewrite Module 2.0, Request Filtering & Security Headers
-->
<configuration>
    <system.webServer>
        <!-- MIME types for locally bundled icon fonts -->
        <staticContent>
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
            <remove fileExtension=".woff" />
            <mimeMap fileExtension=".woff" mimeType="font/woff" />
        </staticContent>

        <!-- Default Document Configuration -->
        <defaultDocument enabled="true">
            <files>
                <clear />
                <add value="index.php" />
                <add value="default.php" />
            </files>
        </defaultDocument>

        <!-- FastCGI Handler Mapping for PHP 8.x -->
        <handlers>
            <clear />
            <!-- FastCGI PHP Handler (Adjust path to php-cgi.exe if PHP is installed outside C:\PHP) -->
            <add name="PHP_via_FastCGI" path="*.php" verb="GET,HEAD,POST,PUT,DELETE,OPTIONS" modules="FastCgiModule" scriptProcessor="C:\PHP\php-cgi.exe" resourceType="Either" requireAccess="Script" />
            <!-- Static files are handled only after PHP mappings. -->
            <add name="StaticFile" path="*" verb="*" modules="StaticFileModule,DefaultDocumentModule,DirectoryListingModule" resourceType="Either" requireAccess="Read" />
        </handlers>

        <!-- Request Filtering & Directory Isolation -->
        <security>
            <requestFiltering>
                <!-- Block direct HTTP access to internal system directories -->
                <hiddenSegments>
                    <add segment="storage" />
                    <add segment="config" />
                    <add segment="app" />
                    <add segment="database" />
                    <add segment="includes" />
                    <add segment="tests" />
                    <add segment="bin" />
                    <add segment="docs" />
                    <add segment=".git" />
                    <add segment=".github" />
                    <add segment="cache" />
                    <add segment="node_modules" />
                    <add segment=".hermes" />
                </hiddenSegments>

                <!-- Block direct download of sensitive file types -->
                <fileExtensions allowUnlisted="true">
                    <add fileExtension=".sql" allowed="false" />
                    <add fileExtension=".log" allowed="false" />
                    <add fileExtension=".env" allowed="false" />
                    <add fileExtension=".ini" allowed="false" />
                    <add fileExtension=".bak" allowed="false" />
                    <add fileExtension=".bak2" allowed="false" />
                    <add fileExtension=".bak3" allowed="false" />
                    <add fileExtension=".md" allowed="false" />
                    <add fileExtension=".yml" allowed="false" />
                    <add fileExtension=".yaml" allowed="false" />
                    <add fileExtension=".sh" allowed="false" />
                    <add fileExtension=".bat" allowed="false" />
                    <add fileExtension=".json" allowed="false" />
                    <add fileExtension=".lock" allowed="false" />
                    <add fileExtension=".drawio" allowed="false" />
                    <add fileExtension=".txt" allowed="false" />
                </fileExtensions>

                <!-- Max allowed upload size: 64 MB (67,108,864 bytes) -->
                <requestLimits maxAllowedContentLength="67108864" />
            </requestFiltering>
        </security>

        <!-- URL Rewrite Rules -->
        <rewrite>
            <rules>
                <!-- Enforce HTTPS; TLS-terminating proxies may forward X-Forwarded-Proto=https. -->
                <rule name="Redirect HTTP to HTTPS" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{HTTPS}" pattern="off" />
                        <add input="{HTTP_X_FORWARDED_PROTO}" pattern="^https$" negate="true" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
                </rule>

                <!-- Rule 1: Redirect Root URL to /public/index.php when root is site physical path -->
                <rule name="Redirect Root to Public" stopProcessing="true">
                    <match url="^$" />
                    <action type="Rewrite" url="public/index.php" />
                </rule>

                <!-- Rule 2: Allow direct access to existing public files and assets -->
                <rule name="Allow Static Assets" stopProcessing="true">
                    <match url="^(assets|public|admin)/.*" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" />
                    </conditions>
                    <action type="None" />
                </rule>

                <!-- Rule 3: Route all other requests through public/index.php -->
                <rule name="Route to Front Controller" stopProcessing="true">
                    <match url="^(.*)$" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="public/index.php?route={R:1}" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>

        <!-- HTTP Security Response Headers -->
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=(), usb=()" />
                <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
                <add name="Content-Security-Policy" value="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://cdn.jsdelivr.net https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'self';" />
            </customHeaders>
        </httpProtocol>

        <!-- Directory Browsing Disabled -->
        <directoryBrowse enabled="false" />
    </system.webServer>
</configuration>
